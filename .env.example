# Environment Variables Example
# Copy this to .env and adjust values for your environment

# Server port (use 3000 for local dev, 3001 for production with nginx reverse proxy)
PORT=3000

# Full URL to your site (used for OG image generation and links)
SITE_URL=http://localhost:3000

# Node environment
NODE_ENV=development

# Path to stats file (for share counters)
STATS_FILE=./stats.json
