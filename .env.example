# Copy to files/.env on the server. server.mjs loads it via
# process.loadEnvFile(), and the deploy workflow carries it between releases.

# Canonical address, including the scheme. Baked into canonical links,
# og:url and og:image — if this is missing the app falls back to
# http://localhost:PORT and every shared link previews the wrong site.
SITE_URL=https://paljonkose.fi

# Passenger assigns the port itself in production; only set this locally.
# PORT=3000

NODE_ENV=production
STATS_FILE=./stats.json

# Required only to call POST /api/reload.
# RELOAD_TOKEN=
