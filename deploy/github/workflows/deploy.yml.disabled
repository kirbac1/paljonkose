name: deploy

# ─────────────────────────────────────────────────────────────────────────
#  DISABLED BY DEFAULT.
#
#  Rename to `deploy.yml` ONLY if you are moving deploys off the server
#  hook and onto GitHub. Running both means two things race to write the
#  same document root — whichever finishes last wins, and you will not be
#  able to tell which commit is actually live.
#
#  To switch over cleanly:
#    1. On the server:  mv /srv/sillasais/repo/hooks/post-receive{,.off}
#    2. Remove the production remote:  git remote remove production
#    3. Rename this file to deploy.yml and push
#
#  Reasons to switch: you want to deploy from a machine that is not your
#  Mac, or you want tests to gate the deploy. Otherwise the server hook is
#  less machinery for the same result.
# ─────────────────────────────────────────────────────────────────────────

on:
  push:
    branches: [main]
  workflow_dispatch:

# Never let two deploys overlap. Unlike the build workflow, in-flight runs
# are NOT cancelled — cancelling mid-rsync leaves a half-written release.
concurrency:
  group: deploy-production
  cancel-in-progress: false

jobs:
  deploy:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    environment: production

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: "22"
          cache: ${{ hashFiles('package-lock.json') != '' && 'npm' || '' }}

      - name: Install
        run: |
          if [ -f package-lock.json ]; then
            npm ci --no-audit --no-fund
          else
            npm install --no-audit --no-fund
          fi

      - name: Build
        env:
          SITE_URL: ${{ vars.SITE_URL || 'https://sillasais.fi' }}
        run: npm run build

      - name: Check the build is publishable
        run: node scripts/check-build.mjs dist

      - name: Set up SSH
        env:
          SSH_KEY: ${{ secrets.DEPLOY_SSH_KEY }}
          SSH_HOST: ${{ secrets.DEPLOY_HOST }}
        run: |
          mkdir -p ~/.ssh
          printf '%s\n' "$SSH_KEY" > ~/.ssh/id_ed25519
          chmod 600 ~/.ssh/id_ed25519
          # Pin the host key instead of accepting whatever answers, so a
          # DNS or routing surprise cannot silently redirect your deploy.
          if [ -n "${{ secrets.DEPLOY_KNOWN_HOSTS }}" ]; then
            printf '%s\n' "${{ secrets.DEPLOY_KNOWN_HOSTS }}" > ~/.ssh/known_hosts
          else
            echo "::warning::DEPLOY_KNOWN_HOSTS not set — falling back to ssh-keyscan (trust on first use)."
            ssh-keyscan -H "$SSH_HOST" >> ~/.ssh/known_hosts 2>/dev/null
          fi
          chmod 600 ~/.ssh/known_hosts

      - name: Publish release
        env:
          SSH_HOST: ${{ secrets.DEPLOY_HOST }}
          SSH_USER: ${{ secrets.DEPLOY_USER }}
        run: |
          set -euo pipefail
          APP_ROOT=/srv/sillasais
          RELEASE="$APP_ROOT/releases/$(date -u +%Y%m%d-%H%M%S)-${GITHUB_SHA::7}"

          # Same release-dir + atomic-symlink model the server hook uses,
          # so rollback.sh keeps working either way.
          ssh "$SSH_USER@$SSH_HOST" "mkdir -p '$RELEASE/dist'"

          rsync -az --delete \
            -e "ssh -o BatchMode=yes" \
            dist/ "$SSH_USER@$SSH_HOST:$RELEASE/dist/"

          # Pass values as remote env vars and feed the script on stdin,
          # rather than interpolating into a nested quoted string. Quoting
          # through ssh is the classic place these workflows break.
          ssh "$SSH_USER@$SSH_HOST" \
            APP_ROOT="$APP_ROOT" RELEASE="$RELEASE" KEEP=5 \
            bash -s <<'REMOTE'
          set -euo pipefail
          ln -sfn "$RELEASE/dist" "$APP_ROOT/current.tmp"
          mv -Tf "$APP_ROOT/current.tmp" "$APP_ROOT/current"

          # Prune by NAME, not mtime: release dirs are YYYYmmdd-HHMMSS-sha,
          # so reverse lexicographic order is reverse chronological order,
          # and two releases made in the same second still sort correctly.
          # mtime sorting ties arbitrarily and can pick the wrong victim.
          cd "$APP_ROOT/releases"
          live="$(readlink -f "$APP_ROOT/current")"
          ls -1d -- */ | sort -r | tail -n +$((KEEP + 1)) | while read -r d; do
            # Never delete whatever is currently being served, whatever
            # the sort says.
            if [ "$(readlink -f "${d}dist")" = "$live" ]; then continue; fi
            rm -rf -- "$d"
          done
          REMOTE

          echo "Deployed ${GITHUB_SHA::7} to $RELEASE"

      - name: Verify the site responds
        env:
          SITE: ${{ vars.SITE_URL || 'https://sillasais.fi' }}
        run: |
          # A deploy that "succeeded" but serves a 502 is not a success.
          for i in 1 2 3; do
            code=$(curl -sS -o /dev/null -w '%{http_code}' --max-time 10 "$SITE" || echo 000)
            [ "$code" = "200" ] && { echo "✓ $SITE returned 200"; exit 0; }
            echo "attempt $i: got $code, retrying…"
            sleep 5
          done
          echo "::error::$SITE did not return 200 after the deploy."
          exit 1
